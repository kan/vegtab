{
  "name": "vegtab",
  "version": "0.0.1",
  "private": true,
  "description": "Vege-Table — daily 3-match puzzle game",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "node scripts/dev.mjs",
    "dev:roji": "roji run vegtab -- node scripts/dev.mjs",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w frontend",
    "deploy": "npm run build && npm run deploy:prod -w backend"
  },
  "workspaces": [
    "engine",
    "frontend",
    "backend"
  ],
  "overrides": {
    "sharp": "^0.35.5",
    "workbox-build": {
      "glob": "^14.0.2"
    }
  }
}
