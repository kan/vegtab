{
  "name": "vegtab",
  "version": "0.0.1",
  "private": true,
  "description": "Vege-Table — daily 3-match puzzle game",
  "scripts": {
    "dev": "concurrently -n back,front -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w frontend",
    "deploy": "npm run build && npm run deploy:prod -w backend"
  },
  "workspaces": [
    "engine",
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
