{
  "name": "@tomado/frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Vue.js SPA frontend",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy:pages": "wrangler pages deploy dist --project-name tomado",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vueuse/core": "^14.2.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.10",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3"
  },
  "dependencies": {
    "vue-i18n": "^11.3.0"
  }
}
