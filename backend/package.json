{
  "name": "@vegtab/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Workers API backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 migrations apply tomado-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply tomado-db --env production --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
