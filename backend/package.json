{
  "name": "@vegtab/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Workers API backend",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../frontend/dist', { recursive: true })\"",
    "dev": "wrangler dev --port 8788",
    "deploy:dev": "npm run db:migrate:dev && wrangler deploy --env dev",
    "deploy:prod": "npm run db:migrate:prod && wrangler deploy --env production",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --env dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "test": "vitest run",
    "typecheck": "wrangler types --check --strict-vars=false && tsc --noEmit",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
