{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The top level is for local development (`npm run dev`, CLAUDE.md「ローカル開発の起動」). env.dev is
  // vegtab-dev.kan-game.app and env.production is vegtab.kan-game.app (with the old vegtab.app).
  // Bindings are not inherited by the environments, so each lists its own.
  "name": "vegtab-local",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // The SPA is served by this same Worker (Static Assets). Build the frontend first: wrangler needs the directory to exist.
  // The API and share pages go to the Worker; everything else is the SPA (unknown paths fall back to index.html)
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"],
  },

  "vars": {
    "ENVIRONMENT": "development",
    // The game's URL (share URLs, the old host's handover) and the origins allowed to call the API
    "FRONTEND_URL": "http://localhost:5173",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    // The old host that only hands its accounts over (src/lib/env.ts). Empty: none
    "LEGACY_HOST": "",
    // The kan-game.app ID cookie and the keys that verify it (kan/game docs/ID_DESIGN.md「ID と Cookie」).
    // Locally they are kan/game's own: scripts/dev.mjs passes ID_PUBLIC_KEYS from kan/game's
    // .dev.vars, with ALLOWED_ORIGINS and FRONTEND_URL for the screen's URL
    "ID_COOKIE_NAME": "__Secure-kgdev_id",
    "ID_ISSUER": "localhost",
    "ID_PUBLIC_KEYS": "[]",
    "VAPID_SUBJECT": "mailto:admin@vegtab.app",
    "VAPID_PUBLIC_KEY": "BPBJ-17ClQf8zOPEDLwGHnrz3hHC8KTYBSQpMdCUnoTZ9KRKWyggM3Y_KBl2cJUD58evORaaaI2ahn9wGbUZCB4",
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "vegtab-local", "database_id": "vegtab-local", "migrations_dir": "migrations" },
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "vegtab-local" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "vegtab-local-replays" }],
  // The kan-game.app ID platform (kan/game). /api/id/* is passed to it, and names are registered
  // through its RPC (src/lib/id-rpc.ts). Locally it is kan/game's `wrangler dev` (the dev registry)
  "services": [{ "binding": "ID", "service": "kan-game-local" }],
  "triggers": { "crons": ["5 15 * * *"] },

  "env": {
    // --- Development environment (vegtab-dev.kan-game.app): `npm run deploy:dev -w backend` ---
    "dev": {
      "name": "vegtab-dev",
      "routes": [{ "pattern": "vegtab-dev.kan-game.app", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "dev",
        "FRONTEND_URL": "https://vegtab-dev.kan-game.app",
        "ALLOWED_ORIGINS": "https://vegtab-dev.kan-game.app",
        "LEGACY_HOST": "",
        // Must match kan/game's env.dev (its wrangler.jsonc). To rotate, follow kan/game
        // docs/ID_DESIGN.md「鍵の管理」 and copy its new list here
        "ID_COOKIE_NAME": "__Secure-kgdev_id",
        "ID_ISSUER": "dev.kan-game.app",
        "ID_PUBLIC_KEYS": "[{\"kid\":\"2026-10-18-2515ed\",\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"0KpEL8A2l9DupwZ2uVJVr_ZGy-sRbGJcJg-2Wwi8McU\",\"y\":\"yMVIO135BT3klr-T0Xtr4cRkdkAvfkwxAMaTzoH5EC4\"}]",
        "VAPID_SUBJECT": "mailto:admin@vegtab.app",
        "VAPID_PUBLIC_KEY": "BBxUshK9WiZ6i_V9Z5JYeE93aaYFMI6l7_6zgIrB2WH9P9KLg_QQbaeXEEuRbcS6v0087qYTZDljRtI-iHdKk7U",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vegtab-dev",
          "database_id": "87d0d69e-8fe1-448d-a1c7-53ba705c46ff",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "715e3a920b88433185d158fface638f9" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "vegtab-dev-replays" }],
      // kan/game's development Worker, which calls back GameService (src/game-service.ts) as
      // GAME_VEGTAB when a player withdraws
      "services": [{ "binding": "ID", "service": "kan-game-dev" }],
      "triggers": { "crons": ["5 15 * * *"] },
    },

    // --- Production (vegtab.kan-game.app): `npm run deploy` at the root ---
    "production": {
      // The name the Worker had before (the top level was vegtab-api), so it is the same Worker
      "name": "vegtab-api-production",
      // vegtab.kan-game.app is a Custom Domain: Cloudflare keeps its DNS record. vegtab.app/* is a
      // route, which needs the proxied AAAA 100:: record in the vegtab.app zone (docs/SPEC.md §5.4).
      // Removing a route from this file does not detach it; delete it in the dashboard too.
      "routes": [
        { "pattern": "vegtab.kan-game.app", "custom_domain": true },
        { "pattern": "vegtab.app/*", "zone_name": "vegtab.app" },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "FRONTEND_URL": "https://vegtab.kan-game.app",
        "ALLOWED_ORIGINS": "https://vegtab.kan-game.app",
        "LEGACY_HOST": "vegtab.app",
        // Must match kan/game's env.production (its wrangler.jsonc)
        "ID_COOKIE_NAME": "__Secure-kg_id",
        "ID_ISSUER": "kan-game.app",
        "ID_PUBLIC_KEYS": "[{\"kid\":\"2026-10-18-ccfc63\",\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"ddT7jKLdotzN141EdW32MjeKrySOCqm_OGKRbA27NBY\",\"y\":\"UR7l_tKX9mUzRzJElH_IFWQ36a0PggvU803FVXI_yqk\"}]",
        "VAPID_SUBJECT": "mailto:admin@vegtab.app",
        "VAPID_PUBLIC_KEY": "BPBJ-17ClQf8zOPEDLwGHnrz3hHC8KTYBSQpMdCUnoTZ9KRKWyggM3Y_KBl2cJUD58evORaaaI2ahn9wGbUZCB4",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tomado-db",
          "database_id": "05a51653-f823-4d9b-8dfb-921d4c8d0a36",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "f35acac0b7e144588ec0509e6b3fa4fa" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "tomado-replay-logs" }],
      "services": [{ "binding": "ID", "service": "kan-game" }],
      "triggers": { "crons": ["5 15 * * *"] },
    },
  },
}
